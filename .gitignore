__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

node_modules/

# generated by `jobfinder dashboard`, consumed by `npm run build` -- neither
# is committed. Netlify builds/deploys frontend/dist/ directly (no GitHub
# Pages /docs convention anymore).
frontend/public/data.json
frontend/public/meta.json
frontend/public/fields.json
frontend/dist/

# Real Netlify secrets for whichever machine runs `docker compose up` --
# docker-compose.yml reads these via ${NETLIFY_AUTH_TOKEN}/${NETLIFY_SITE_ID}
# substitution from a .env file in the same directory, never hardcoded in
# the committed compose file itself.
.env

# redeploy-watch.sh's own bookkeeping (a source-tree hash, not a secret) --
# machine-local state, regenerated on first run, never meaningful to commit.
.last-deploy-hash

# The DB's answers/applications tables are personal data (name, contact
# info, work-auth answers, application history). It must never go into git
# regardless of repo visibility. Public, listings-only data is what the
# built dashboard's data.json is for -- generated, deployed, never committed.
jobfinder.db
jobfinder.db-wal
jobfinder.db-shm
resume.pdf

# Local Netlify folder
.netlify

# Stale GitHub Pages build output from before the dashboard moved to
# Netlify -- dead build artifact, not source, nothing in the current
# pipeline reads from it.
docs/
